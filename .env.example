# Form delivery (Reserve + Contact). Copy to .env.local.
# Without RESEND_API_KEY, `next dev` prints submissions to the terminal and production returns an error.
RESEND_API_KEY=
# Verified sender on your Resend domain.
FORMS_FROM="Valor Limo <reservations@valorlimo.com>"
# The reservations inbox (required in production). CONTACT_TO is optional; it defaults to RESERVATIONS_TO.
RESERVATIONS_TO=
CONTACT_TO=
